<?xml version="1.0" encoding="utf-8"?>
<!-- The store build only. -->
<!-- Lint reads this file alone: the TV launcher entry and the optional touchscreen are in the main manifest. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="MissingLeanbackLauncher,ImpliedTouchscreenHardware">

    <!-- For TVs only: the store mustn't offer a TV home screen to phones (it would then also want phone
         screenshots). The adb build leaves it optional. -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="true"
        tools:replace="android:required" />
</manifest>
