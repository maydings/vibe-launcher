    <!-- Settings > Apps: turning apps off and on through the TV's own network debugging (Adb, TvApps, SettingsScreen). -->
    <string name="tab_apps">고급</string>
    <string name="apps_short">사용하지 않는 앱을 끄세요: 앱은 설치된 상태로 남지만, 다시 켤 때까지 실행되거나 홈 화면을 채우거나 업데이트되지 않습니다. 기기 작동에 필요한 부분은 목록에 없습니다.</string>
    <string name="adb_connection">ADB 연결</string>
    <string name="adb_connection_short">Vibe Launcher는 컴퓨터처럼 기기 자체의 ADB를 통해 앱을 끕니다. 무엇이 켜져 있는지 보고 연결하려면 여세요.</string>
    <string name="adb_checking">확인 중…</string>
    <string name="adb_allow_prompt">기기가 Vibe Launcher를 허용할지 묻습니다: 항상 허용에 체크한 다음 확인을 누르세요.</string>
    <string name="adb_turn_on">개발자 옵션에서 USB 디버깅을 켜고(일부 기기에서는 ADB 디버깅 또는 네트워크 디버깅이라고 함) 여기로 돌아오세요.</string>
    <string name="adb_network_closed">디버깅이 켜져 있지만 이 기기는 아직 앱의 접근을 허용하지 않습니다. 개발자 옵션에서 네트워크 디버깅 또는 네트워크를 통한 ADB를 찾아 켜세요. 무선 디버깅만 있다면 Vibe Launcher는 아직 사용할 수 없습니다.</string>
    <string name="adb_failed">기기가 허용하지 않았습니다</string>
    <string name="apps_turn_all_on">모두 다시 사용 설정</string>
    <string name="apps_turn_all_on_short">Vibe Launcher가 사용 중지한 모든 앱을 다시 사용 설정합니다.</string>
    <string name="apps_all_on">모두 다시 사용 설정됨</string>
    <string name="adb_no_key">이 기기는 Vibe Launcher에 필요한 키를 보관할 수 없습니다</string>
    <string name="apps_can_turn_off">사용 중지할 수 있는 앱</string>
    <string name="apps_tv_needs">기기에 필요한 앱</string>
    <string name="app_protected">기기가 제대로 작동하려면 필요하므로 Vibe Launcher가 끄지 않습니다. 이렇게 하면 기기를 안전하게 지킬 수 있습니다.</string>
    <string name="adb_dev_options">먼저 개발자 옵션을 사용 설정하세요. ‘정보’에서 ‘빌드’에 OK를 일곱 번 누른 다음 여기로 돌아오세요.</string>
    <string name="wireless_debugging">무선 디버깅</string>
    <string name="wireless_debugging_short">휴대전화로 스캔한 다음 기기에 표시된 코드를 입력하세요.</string>
    <string name="paired">페어링됨</string>
    <string name="not_paired">페어링되지 않음</string>
    <string name="pair_scan">휴대전화로 스캔한 다음 아래의 개발자 옵션을 여세요. 무선 디버깅을 사용 설정하고 연 다음 ‘페어링 코드로 기기 페어링’을 선택하고 표시되는 코드를 휴대전화에 입력하세요.</string>
    <string name="adb_wireless_on">개발자 옵션에서 무선 디버깅을 사용 설정한 다음 여기로 돌아오세요.</string>
    <string name="adb_wireless_wifi">이 기기는 네트워크를 통한 디버깅 접근을 앱에 허용하지 않으며, 무선 디버깅은 Wi-Fi에서만 작동합니다. Vibe Launcher를 페어링하려면 기기를 Wi-Fi에 연결하거나, 개발자 옵션에서 네트워크 디버깅을 찾으세요.</string>
    <string name="paired_toast">무선 디버깅으로 페어링됨</string>
    <string name="adb_not_connected">연결되지 않음</string>
