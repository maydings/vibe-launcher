<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <!-- No background of its own: the window's is already black, and every full-screen paint costs
         a frame's worth of GPU fill on TV chips. -->

    <!-- Backdrop still for the focused dock app, darkened for legibility (baked in by Backdrops). -->
    <FrameLayout
        android:id="@+id/backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0">

        <!-- The previous still, under the new one while they cross-fade. -->
        <ImageView
            android:id="@+id/backdropPrevious"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:visibility="gone"
            android:contentDescription="@null" />

        <ImageView
            android:id="@+id/backdropImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="@null" />

        <!-- A film or show's title on its backdrop: the logo, or the name when there is none. Above the
             tint so it stays bright; lined up with the app name by MainActivity. -->
        <FrameLayout
            android:id="@+id/backdropTitleBox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|top"
            android:layout_marginEnd="50dp">

            <ImageView
                android:id="@+id/backdropLogo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|bottom"
                android:maxWidth="340dp"
                android:maxHeight="110dp"
                android:adjustViewBounds="true"
                android:scaleType="fitEnd"
                android:visibility="gone"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/backdropTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|bottom"
                android:gravity="end"
                android:maxWidth="420dp"
                android:maxLines="2"
                android:ellipsize="end"
                android:visibility="gone"
                android:textColor="#FFFFFFFF"
                android:textSize="34sp"
                android:fontFamily="@string/font_regular"
                android:includeFontPadding="false"
                android:shadowColor="#99000000"
                android:shadowRadius="14" />
        </FrameLayout>
    </FrameLayout>

    <!-- Ambient glow in the colour of the focused dock app (apps without a backdrop). -->
    <View
        android:id="@+id/ambient"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0" />

    <!-- Top shelf: the focused dock app's name, positioned above the dock in code. -->
    <TextView
        android:id="@+id/heroName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="62dp"
        android:alpha="0"
        android:textColor="#FFFFFFFF"
        android:textSize="48sp"
        android:fontFamily="@string/font_regular"
        android:letterSpacing="-0.02"
        android:includeFontPadding="false"
        android:singleLine="true" />

    <!-- The wrapper clips at its edge; the grid itself must not clip so scaled tiles can overflow their
         cells. The grid runs the full height so tiles scroll up under the top bar, which frosts them.
         The tiles keep 50dp from the screen's sides: 36dp of margin and 14dp of the grid's padding, which
         leaves the dock's band (DockDecoration, 14dp around the tiles) room for its sides inside the clip;
         at 6 tiles per row they were cut off. -->
    <FrameLayout
        android:id="@+id/rows"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="36dp"
        android:layout_marginEnd="36dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="10dp"
            android:paddingBottom="40dp"
            android:clipToPadding="false"
            android:clipChildren="false"
            android:overScrollMode="never"
            android:scrollbars="none"
            android:descendantFocusability="afterDescendants" />
    </FrameLayout>

    <!-- Top bar over the grid, on a frosted copy of whatever has scrolled beneath it. -->
    <FrameLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.maydings.vibelauncher.FrostView
            android:id="@+id/frost"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="50dp"
            android:layout_marginEnd="50dp"
            android:layout_marginTop="26dp"
            android:layout_marginBottom="10dp">

            <LinearLayout
                android:id="@+id/leftBlock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_toStartOf="@+id/topButtons"
                android:layout_marginEnd="16dp"
                android:orientation="vertical">

                <!-- Hidden until the TV knows the time (MainActivity). -->
                <LinearLayout
                    android:id="@+id/clockRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="false">
                    <!-- Pinned to the bottom, not to the clock's baseline, so a two-line date grows upwards
                         without lifting AM with it. -->

                    <!-- The time and AM/PM, as wide as the widest time with as many hour digits, so the date
                         doesn't shift from 1:40 to 1:41: the digits differ in width (sized in MainActivity). -->
                    <LinearLayout
                        android:id="@+id/timeBox"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:baselineAligned="false">

                        <TextClock
                            android:id="@+id/clock"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:format12Hour="h:mm"
                            android:format24Hour="HH:mm"
                            android:textColor="#FFFFFFFF"
                            android:textSize="52sp"
                            android:fontFamily="@string/font_regular"
                            android:letterSpacing="-0.04"
                            android:includeFontPadding="false" />

                        <TextClock
                            android:id="@+id/ampm"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_gravity="bottom"
                            android:layout_marginBottom="16.5dp"
                            android:format12Hour="a"
                            android:format24Hour=""
                            android:textColor="#B3FFFFFF"
                            android:textSize="15sp"
                            android:fontFamily="@string/font_regular"
                            android:letterSpacing="0.08"
                            android:textAllCaps="true" />
                    </LinearLayout>

                    <!-- A long date (other languages) wraps onto a second line, growing upwards, instead of
                         running into the pills: the clock block ends where they begin. -->
                    <TextClock
                        android:id="@+id/date"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="20dp"
                        android:layout_gravity="bottom"
                        android:layout_marginBottom="17.5dp"
                        android:maxLines="2"
                        android:ellipsize="end"
                        android:format12Hour="EEEE  d MMMM yyyy"
                        android:format24Hour="EEEE  d MMMM yyyy"
                        android:textColor="#A6FFFFFF"
                        android:textSize="14sp"
                        android:fontFamily="@string/font_regular"
                        android:letterSpacing="0.14"
                        android:textAllCaps="true" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/topButtons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_alignBottom="@id/leftBlock"
                android:layout_marginBottom="6dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnInputs"
                    style="@style/TopButton"
                    android:text="@string/inputs"
                    android:drawableStart="@drawable/ic_input"
                    android:nextFocusDown="@+id/grid" />

                <TextView
                    android:id="@+id/btnWifi"
                    style="@style/TopButton"
                    android:text="@string/wifi"
                    android:drawableStart="@drawable/ic_wifi"
                    android:nextFocusDown="@+id/grid" />

                <!-- A green dot in the gear's hollow centre while an update is ready (MainActivity.showUpdateReady).
                     Placed from the start: TopButton's 10dp margin and 16dp padding put the 22dp gear's centre
                     37dp across and 21dp down. -->
                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/btnSettings"
                        style="@style/TopButton"
                        android:text="@string/settings"
                        android:drawableStart="@drawable/ic_settings"
                        android:nextFocusDown="@+id/grid" />

                    <View
                        android:id="@+id/updateDot"
                        android:layout_width="5dp"
                        android:layout_height="5dp"
                        android:layout_gravity="top|start"
                        android:layout_marginTop="18.5dp"
                        android:layout_marginStart="34.5dp"
                        android:background="@drawable/status_dot"
                        android:visibility="gone" />
                </FrameLayout>
            </LinearLayout>
        </RelativeLayout>
    </FrameLayout>

    <!-- The slideshow's clock: the top bar's time and AM/PM, without the bar, put where they are on it (in
         MainActivity). -->
    <LinearLayout
        android:id="@+id/slideClock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:alpha="0"
        android:visibility="invisible"
        android:importantForAccessibility="no">

        <TextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="h:mm"
            android:format24Hour="HH:mm"
            android:textColor="#FFFFFFFF"
            android:textSize="52sp"
            android:fontFamily="@string/font_regular"
            android:letterSpacing="-0.04"
            android:includeFontPadding="false" />

        <TextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_gravity="bottom"
            android:layout_marginBottom="16.5dp"
            android:format12Hour="a"
            android:format24Hour=""
            android:textColor="#B3FFFFFF"
            android:textSize="15sp"
            android:fontFamily="@string/font_regular"
            android:letterSpacing="0.08"
            android:textAllCaps="true" />
    </LinearLayout>

    <!-- Where the remote goes: up from the dock to the picture alone (right above the dock, placed in
         code), and with the picture alone all four ways (see MainActivity.updateCarets). -->
    <ImageView
        android:id="@+id/caretDock"
        android:layout_width="28dp"
        android:layout_height="14dp"
        android:layout_gravity="top|center_horizontal"
        android:src="@drawable/ic_caret"
        android:alpha="0"
        android:importantForAccessibility="no" />

    <!-- Down from the dock, to the other apps: in the space under its panel, which ends 22dp (half the space
         between two rows of tiles) above the screen's bottom edge (see MainActivity's grid padding). -->
    <ImageView
        android:id="@+id/caretMore"
        android:layout_width="28dp"
        android:layout_height="14dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="4dp"
        android:rotation="180"
        android:src="@drawable/ic_caret"
        android:alpha="0"
        android:importantForAccessibility="no" />

    <!-- Down from the top bar, to the picture alone: just under the bar while it has focus (placed in code). -->
    <ImageView
        android:id="@+id/caretBar"
        android:layout_width="28dp"
        android:layout_height="14dp"
        android:layout_gravity="top|center_horizontal"
        android:rotation="180"
        android:src="@drawable/ic_caret"
        android:alpha="0"
        android:importantForAccessibility="no" />

    <ImageView
        android:id="@+id/caretUp"
        android:layout_width="28dp"
        android:layout_height="14dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="14dp"
        android:src="@drawable/ic_caret"
        android:alpha="0"
        android:importantForAccessibility="no" />

    <ImageView
        android:id="@+id/caretDown"
        android:layout_width="28dp"
        android:layout_height="14dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="14dp"
        android:rotation="180"
        android:src="@drawable/ic_caret"
        android:alpha="0"
        android:importantForAccessibility="no" />

    <ImageView
        android:id="@+id/caretLeft"
        android:layout_width="28dp"
        android:layout_height="14dp"
        android:layout_gravity="start|center_vertical"
        android:layout_marginStart="6dp"
        android:rotation="-90"
        android:src="@drawable/ic_caret"
        android:alpha="0"
        android:importantForAccessibility="no" />

    <ImageView
        android:id="@+id/caretRight"
        android:layout_width="28dp"
        android:layout_height="14dp"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="6dp"
        android:rotation="90"
        android:src="@drawable/ic_caret"
        android:alpha="0"
        android:importantForAccessibility="no" />

    <!-- With the picture alone: a Play pill where the app's name was, sliding in from the left (placed in
         code), and under it the time left on something you're watching. Holding OK fills the pill with
         the focused look from the reading side (holdPlayFill, revealed in code), then opens the title. -->
    <LinearLayout
        android:id="@+id/holdPlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="62dp"
        android:orientation="vertical"
        android:alpha="0"
        android:visibility="invisible"
        android:importantForAccessibility="no">

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <TextView
                style="@style/TopButton"
                android:layout_marginStart="0dp"
                android:text="@string/play"
                android:drawableStart="@drawable/ic_play"
                android:textAllCaps="true"
                android:focusable="false"
                android:clickable="false" />

            <TextView
                android:id="@+id/holdPlayFill"
                style="@style/TopButton"
                android:layout_marginStart="0dp"
                android:text="@string/play"
                android:drawableStart="@drawable/ic_play"
                android:textAllCaps="true"
                android:background="@drawable/pill_filled"
                android:textColor="#FF111111"
                android:drawableTint="#FF111111"
                android:focusable="false"
                android:clickable="false" />
        </FrameLayout>

        <TextView
            android:id="@+id/playInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="10dp"
            android:textColor="#CCFFFFFF"
            android:textSize="16sp"
            android:fontFamily="@string/font_regular"
            android:shadowColor="#99000000"
            android:shadowRadius="6"
            android:visibility="gone" />
    </LinearLayout>

    <!-- The single floating glass highlight that springs between tiles. -->
    <com.maydings.vibelauncher.GlassView
        android:id="@+id/glass"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:alpha="0"
        android:importantForAccessibility="no" />
</FrameLayout>
