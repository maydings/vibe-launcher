<?xml version="1.0" encoding="utf-8"?>
<!-- A newer release before it installs: its version, what changed, and Install or Cancel (SettingsScreen). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="560dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/glass_panel"
    android:padding="28dp">

    <TextView
        android:id="@+id/updateTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#FFFFFFFF"
        android:textSize="22sp"
        android:fontFamily="@string/font_regular" />

    <!-- Capped in height (SettingsScreen); long notes scroll. -->
    <ScrollView
        android:id="@+id/notesScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp">

        <TextView
            android:id="@+id/notes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#BFFFFFFF"
            android:textSize="15sp"
            android:lineSpacingMultiplier="1.15"
            android:fontFamily="@string/font_regular" />
    </ScrollView>

    <!-- Where a name is typed, for the dialogs that ask one (NameDialog). -->
    <EditText
        android:id="@+id/field"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:visibility="gone"
        android:importantForAutofill="no"
        android:inputType="text"
        android:imeOptions="actionDone|flagNoExtractUi"
        android:maxLines="1"
        android:textColor="#FFFFFFFF"
        android:textSize="18sp"
        android:fontFamily="@string/font_regular"
        android:hint="@null" />

    <!-- A new passphrase typed a second time (NameDialog.askNewSecret): both must match. -->
    <EditText
        android:id="@+id/fieldAgain"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:visibility="gone"
        android:importantForAutofill="no"
        android:inputType="textPassword"
        android:imeOptions="actionDone|flagNoExtractUi"
        android:maxLines="1"
        android:textColor="#FFFFFFFF"
        android:textColorHint="#99FFFFFF"
        android:textSize="18sp"
        android:fontFamily="@string/font_regular"
        android:hint="@string/backup_passphrase_again" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="horizontal"
        android:gravity="end">

        <!-- A third choice, for the dialogs that have one (a Library item: Rename). -->
        <TextView
            xmlns:tools="http://schemas.android.com/tools"
            android:id="@+id/extra"
            style="@style/TopButton"
            android:paddingStart="20dp"
            android:visibility="gone"
            tools:ignore="RtlSymmetry" />

        <TextView
            android:id="@+id/install"
            style="@style/TopButton"
            android:paddingStart="20dp"
            android:text="@string/install" />

        <TextView
            android:id="@+id/cancelUpdate"
            style="@style/TopButton"
            android:paddingStart="20dp"
            android:text="@string/cancel" />
    </LinearLayout>
</LinearLayout>
