<?xml version="1.0" encoding="utf-8"?>
<!-- Vibe Launcher settings, full screen and opaque: the page's name on top, the logo on the
     left and the list on the right. Opening a row slides its list over the logo and its page in on the right
     (SettingsScreen adds the lists to the stage and places the logo). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <!-- No background of its own: the window's (settings_bg, Theme.Settings) is the screen's, drawn once. -->

    <ImageView
        android:id="@+id/logo"
        android:layout_width="250dp"
        android:layout_height="250dp"
        android:layout_gravity="center_vertical|start"
        android:src="@drawable/settings_logo"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="28dp"
        android:textColor="#99FFFFFF"
        android:textSize="27sp"
        android:fontFamily="@string/font_medium" />

    <FrameLayout
        android:id="@+id/stage"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- The project's home, under the logo (placed in SettingsScreen). Plain text: TVs rarely have a browser
         to open it in. -->
    <TextView
        android:id="@+id/projectLink"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginBottom="22dp"
        android:gravity="center"
        android:text="@string/project_link"
        android:textColor="#66FFFFFF"
        android:textSize="12sp"
        android:fontFamily="@string/font_regular" />
</FrameLayout>
