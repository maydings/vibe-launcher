    <string name="dev_options_short">在「關於」中解鎖：在「版本號碼」上按 OK 7 次。</string>
    <string name="usb_adb_debugging">USB/ADB 偵錯</string>
    <string name="usb_adb_debugging_short">開發人員選項中的偵錯開關。在大多數電視上會開啟連接埠 5555。</string>
    <string name="wireless_debugging_onoff_short">透過 Wi-Fi 偵錯（Android 11 以上）。連接埠 5555 關閉時使用。</string>
    <string name="pair_with_code">使用配對碼配對</string>
