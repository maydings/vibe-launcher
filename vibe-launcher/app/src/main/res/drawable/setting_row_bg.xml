<?xml version="1.0" encoding="utf-8"?>
<!-- A Settings row: white when focused, faint glass otherwise; activated is the row whose
     page is open, on the list slid to the left. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape><solid android:color="#FFFFFFFF" /><corners android:radius="10dp" /></shape>
    </item>
    <item android:state_activated="true">
        <shape><solid android:color="#40FFFFFF" /><corners android:radius="10dp" /></shape>
    </item>
    <item>
        <shape><solid android:color="#17FFFFFF" /><corners android:radius="10dp" /></shape>
    </item>
</selector>
