<?xml version="1.0" encoding="utf-8"?>
<!-- The adb build only: updating itself from the project's releases (the store build updates through Play). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Updates from the project's releases (Updater); Android still asks before installing. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Closes the TV's Settings while it's in the background before opening its Install unknown apps
         switch, so it lists Vibe Launcher by name (Updater). -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <application>
        <!-- The installer's answer about an update: its confirmation screen, or why it didn't install;
             and the new version being in, to bring Home back. -->
        <receiver
            android:name=".UpdateReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
