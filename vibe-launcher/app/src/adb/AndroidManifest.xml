<?xml version="1.0" encoding="utf-8"?>
<!-- The adb build only: updating itself from the project's releases, and installing SmartTube. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Updates from the project's releases (Updater); Android still asks before installing. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Closes the TV's Settings while it's in the background before opening its Install unknown apps
         switch, so it lists Vibe Launcher by name (Updater). -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <!-- Settings > Apps lists every app on the TV, system parts with no tile too, to turn them off (TvApps):
         Android 11+ hides those without this. Not in the store build, which has no Settings > Apps. -->
    <!-- Granted by the TV's own ADB the first time Settings > Apps connects (pm grant), never by installing:
         debugging on and off, and the animation speeds, and nothing else (TvControl). -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        xmlns:tools="http://schemas.android.com/tools"
        tools:ignore="ProtectedPermissions" />
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        xmlns:tools="http://schemas.android.com/tools"
        tools:ignore="QueryAllPackagesPermission" />

    <application>
        <!-- The installer's answer about an update: its confirmation screen, or why it didn't install;
             and the new version being in, to bring Home back. -->
        <receiver
            android:name=".UpdateReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
